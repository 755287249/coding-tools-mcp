{
  "name": "coding-tools-mcp-desktop",
  "version": "0.1.109",
  "description": "Coding Tools MCP desktop client",
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "dev": "vite dev",
    "predesktop": "pnpm run version:sync",
    "desktop": "tauri dev",
    "desktop:dev:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-rust-desktop.ps1",
    "rust:dev:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-rust-desktop.ps1 -OnceBuild",
    "predesktop:build": "pnpm run version:sync",
    "desktop:build": "tauri build --features desktop,custom-protocol",
    "desktop:build:nsis": "pnpm run version:sync && tauri build --features desktop,custom-protocol --bundles nsis",
    "desktop:build:macos": "pnpm run version:sync && tauri build --features desktop,custom-protocol --target universal-apple-darwin --bundles dmg",
    "desktop:build:macos:app": "pnpm run version:sync && tauri build --features desktop,custom-protocol --target universal-apple-darwin --bundles app,dmg",
    "desktop:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "desktop:switch:latest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/switch-rust-desktop-to-latest.ps1",
    "release:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "release:portable:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -Target desktop",
    "release:portable:node": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -Target node",
    "node-agent:install": "pnpm install --frozen-lockfile",
    "node-agent:build": "pnpm --filter @coding-tools/node-agent run build",
    "node-agent:test": "pnpm --filter @coding-tools/node-agent test",
    "node-agent:verify": "pnpm --filter @coding-tools/node-agent run verify",
    "node-agent:contract": "pnpm --filter @coding-tools/node-agent run check:rust-contract",
    "node-agent:client-version": "pnpm --filter @coding-tools/node-agent run check:client-version",
    "node-agent:parity:check": "node scripts/check-node-agent-parity.mjs",
    "node-agent:parity:complete": "node scripts/check-node-agent-parity.mjs --require-complete",
    "node-agent:ui-parity:check": "node scripts/check-node-agent-ui-parity.mjs",
    "node-agent:verify-repo": "pnpm --filter @coding-tools/node-agent run verify:repo",
    "node-agent:start": "pnpm --filter @coding-tools/node-agent start",
    "node-agent:portable": "pnpm --filter @coding-tools/node-agent run portable",
    "node-agent:portable:bundled": "pnpm --filter @coding-tools/node-agent run portable:bundled",
    "node-agent:portable:system": "pnpm --filter @coding-tools/node-agent run portable:system",
    "node-agent:portable:dev:bundled": "pnpm --filter @coding-tools/node-agent run portable:dev:bundled",
    "start": "tauri dev",
    "ui:build:desktop": "vite build",
    "ui:build:node": "pnpm --filter @coding-tools/node-agent run build:ui",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "verify:fast": "node scripts/verify-frontend.mjs",
    "verify": "pnpm run verify:fast && pnpm run build",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "rust:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rust-check.ps1",
    "rust:check:headless": "cargo check --manifest-path src-tauri/Cargo.toml --no-default-features --lib && cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --test headless_core && cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --lib task_runtime::headless::tests",
    "rust:fmt": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rustfmt-changed.ps1",
    "rust:fmt:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rustfmt-changed.ps1 -Check",
    "precommit": "node scripts/precommit.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "rust:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-fast.ps1",
    "rust:test:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-full.ps1",
    "rust:command-policy:test": "cargo test --manifest-path crates/command-policy/Cargo.toml",
    "rust:benchmark": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/benchmark-runtime.ps1",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:patch": "pnpm version patch --no-git-tag-version && pnpm run version:sync",
    "pretauri": "pnpm run version:sync",
    "tauri": "tauri"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@lucide/svelte": "^1.31.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.1"
  }
}
